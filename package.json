{
    "name": "roest",
    "module": "lib.ts",
    "type": "module",
    "version": "0.0.1",
    "bin": {
        "roest": "./dist/roest"
    },
    "files": [
        "dist/roest",
        "dist/lib.js",
        "dist/lib.d.ts",
        "dist/src",
        "README.md",
        "LICENSE.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/lib.d.ts",
            "default": "./dist/lib.js"
        }
    },
    "scripts": {
        "build": "bun run build:web && bun run build:cli && bun run build:lib",
        "build:cli": "bun build index.ts --target=node --outfile=dist/roest",
        "build:lib": "bun build lib.ts --target=node --outfile=dist/lib.js --format=esm && bun run build:types",
        "build:types": "tsc lib.ts --declaration --emitDeclarationOnly --outDir dist --skipLibCheck",
        "build:web": "vite build",
        "dev:web": "vite dev",
        "biome:check": "biome check --write ./",
        "biome:format": "biome format --write ./src/",
        "biome:lint": "biome lint --write ./src/"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@types/bun": "latest",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "@types/semver": "^7.7.1",
        "@vitejs/plugin-react-swc": "^4.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "semver": "^7.7.2",
        "typescript": "^5.9.2",
        "vite": "^7.1.9"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "commander": "^14.0.1",
        "json5": "^2.2.3",
        "octokit": "^5.0.3",
        "ora": "^8.2.0",
        "vite-plugin-singlefile": "^2.3.0"
    }
}
